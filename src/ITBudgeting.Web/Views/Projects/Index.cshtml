@model IEnumerable<ITBudgeting.Application.DTOs.ProjectDto>
@{ ViewData["Title"] = "Projects"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📁 Projects</h2>
    <a asp-action="Create" class="btn btn-primary">+ New</a>
</div>
<table class="table table-striped datatable">
    <thead class="table-dark"><tr><th>Name</th><th>Category</th><th>Active</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Name</td>
            <td><span class="badge text-bg-@(p.Category.ToString() == "CapEx" ? "info" : "secondary")">@p.Category</span></td>
            <td>@(p.IsActive ? "<span class='badge text-bg-success'>Active</span>" : "<span class='badge text-bg-secondary'>Inactive</span>")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete?')">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
