@model ITBudgeting.Web.ViewModels.CreateBudgetVersionViewModel
@{ ViewData["Title"] = "New Budget Version"; }
<h2 class="mb-4">New Budget Version</h2>
<div class="card" style="max-width:500px">
  <div class="card-body">
    <form asp-action="Create" method="post">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="All" class="text-danger small mb-2"></div>
      <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
      </div>
      <div class="mb-3">
        <label asp-for="Year" class="form-label"></label>
        <input asp-for="Year" class="form-control" type="number" />
        <span asp-validation-for="Year" class="text-danger small"></span>
      </div>
      <div class="mb-3">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<ITBudgeting.Domain.Enums.BudgetVersionType>()" class="form-select"></select>
      </div>
      <button type="submit" class="btn btn-primary">Create</button>
      <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
  </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
