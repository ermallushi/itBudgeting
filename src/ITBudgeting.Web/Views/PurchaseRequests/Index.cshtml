@using ITBudgeting.Domain.Enums
@model IEnumerable<ITBudgeting.Application.DTOs.PurchaseRequestDto>
@{ ViewData["Title"] = "Purchase Requests"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🛒 Purchase Requests</h2>
    <a asp-action="Create" class="btn btn-primary">+ New PR</a>
</div>
<table class="table table-striped datatable">
    <thead class="table-dark"><tr><th>ID</th><th>Amount</th><th>Status</th><th>SharePoint</th><th>Created By</th><th>Created At</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var pr in Model)
    {
        var badge = pr.Status switch {
            PurchaseRequestStatus.Draft    => "secondary",
            PurchaseRequestStatus.Submitted => "warning",
            PurchaseRequestStatus.Approved => "success",
            PurchaseRequestStatus.Rejected => "danger",
            _ => "secondary"
        };
        <tr>
            <td><small class="text-muted">@pr.Id.ToString()[..8]…</small></td>
            <td>@pr.Amount.ToString("C")</td>
            <td><span class="badge text-bg-@badge">@pr.Status</span></td>
            <td>@(pr.SharePointUrl != null ? Html.Raw($"<a href='{pr.SharePointUrl}' target='_blank'>Link</a>") : "-")</td>
            <td>@pr.CreatedBy</td>
            <td>@pr.CreatedAt.ToString("yyyy-MM-dd")</td>
            <td>
                @if (pr.Status == PurchaseRequestStatus.Draft || pr.Status == PurchaseRequestStatus.Submitted)
                {
                    <a asp-action="Edit" asp-route-id="@pr.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="Approve" asp-route-id="@pr.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-success" onclick="return confirm('Approve and create PO?')">Approve</button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@pr.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete?')">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
