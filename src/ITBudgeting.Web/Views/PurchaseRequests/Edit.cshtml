@model ITBudgeting.Web.ViewModels.EditPurchaseRequestViewModel
@{ ViewData["Title"] = "Edit Purchase Request"; }
<h2 class="mb-4">Edit Purchase Request</h2>
<div class="card" style="max-width:500px">
  <div class="card-body">
    <form asp-action="Edit" method="post">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="All" class="text-danger small mb-2"></div>
      <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" class="form-control" type="number" step="0.01" />
      </div>
      <div class="mb-3">
        <label asp-for="SharePointUrl" class="form-label">SharePoint URL</label>
        <input asp-for="SharePointUrl" class="form-control" />
      </div>
      <button type="submit" class="btn btn-primary">Save</button>
      <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
  </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
