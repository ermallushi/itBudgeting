@model IEnumerable<ITBudgeting.Application.DTOs.CostCenterDto>
@{ ViewData["Title"] = "Cost Centers"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🏢 Cost Centers</h2>
    <a asp-action="Create" class="btn btn-primary">+ New</a>
</div>
<table class="table table-striped datatable">
    <thead class="table-dark"><tr><th>Name</th><th>Department</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Name</td>
            <td>@c.Department</td>
            <td>
                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete?')">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
