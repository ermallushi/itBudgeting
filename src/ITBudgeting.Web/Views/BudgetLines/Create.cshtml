@model ITBudgeting.Web.ViewModels.CreateBudgetLineViewModel
@{ ViewData["Title"] = "New Budget Line"; }
<h2 class="mb-4">New Budget Line</h2>
<div class="card" style="max-width:550px">
  <div class="card-body">
    <form asp-action="Create" method="post">
      @Html.AntiForgeryToken()
      <input asp-for="VersionId" type="hidden" />
      <div asp-validation-summary="All" class="text-danger small mb-2"></div>
      <div class="mb-3">
        <label asp-for="CostCenterId" class="form-label">Cost Center</label>
        <select asp-for="CostCenterId" asp-items="Model.CostCenters" class="form-select">
          <option value="">-- Select --</option>
        </select>
      </div>
      <div class="mb-3">
        <label asp-for="ProjectId" class="form-label">Project</label>
        <select asp-for="ProjectId" asp-items="Model.Projects" class="form-select">
          <option value="">-- Select --</option>
        </select>
      </div>
      <div class="mb-3">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" asp-items="Html.GetEnumSelectList<ITBudgeting.Domain.Enums.BudgetCategory>()" class="form-select"></select>
      </div>
      <div class="mb-3">
        <label asp-for="Period" class="form-label">Period (YYYY-MM)</label>
        <input asp-for="Period" class="form-control" placeholder="2026-01" />
        <span asp-validation-for="Period" class="text-danger small"></span>
      </div>
      <div class="mb-3">
        <label asp-for="PlannedAmount" class="form-label"></label>
        <input asp-for="PlannedAmount" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="PlannedAmount" class="text-danger small"></span>
      </div>
      <button type="submit" class="btn btn-primary">Create</button>
      <a asp-action="Index" asp-route-versionId="@Model.VersionId" class="btn btn-secondary ms-2">Cancel</a>
    </form>
  </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
