<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Budgeting</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <style>
        body { overflow-x: hidden; }
        #sidebar { width: 240px; min-height: 100vh; background: #212529; }
        #sidebar a { color: #adb5bd; text-decoration: none; }
        #sidebar a:hover, #sidebar a.active { color: #fff; background: rgba(255,255,255,.1); border-radius: 4px; }
        #content { flex: 1; min-height: 100vh; }
    </style>
</head>
<body>
<div class="d-flex">
    <!-- Sidebar -->
    <nav id="sidebar" class="d-flex flex-column px-3 py-3">
        <a class="navbar-brand text-white fw-bold fs-5 mb-4 d-block" href="/">💰 IT Budgeting</a>
        <ul class="list-unstyled mb-auto">
            <li class="mb-1"><a class="d-block py-1 px-2" asp-controller="Home" asp-action="Index">📊 Dashboard</a></li>
            <li class="mb-1"><a class="d-block py-1 px-2" asp-controller="BudgetVersions" asp-action="Index">📋 Budget Versions</a></li>
            <li class="mb-1"><a class="d-block py-1 px-2" asp-controller="BudgetLines" asp-action="Index">📝 Budget Lines</a></li>
            <li class="mb-1"><a class="d-block py-1 px-2" asp-controller="BudgetPeriods" asp-action="Index">📅 Periods</a></li>
            <li class="mb-1"><a class="d-block py-1 px-2" asp-controller="CostCenters" asp-action="Index">🏢 Cost Centers</a></li>
            <li class="mb-1"><a class="d-block py-1 px-2" asp-controller="Projects" asp-action="Index">📁 Projects</a></li>
            <li class="mb-1"><a class="d-block py-1 px-2" asp-controller="PurchaseRequests" asp-action="Index">🛒 Purchase Requests</a></li>
            <li class="mb-1"><a class="d-block py-1 px-2" asp-controller="PurchaseOrders" asp-action="Index">📦 Purchase Orders</a></li>
            <li class="mb-1"><a class="d-block py-1 px-2" asp-controller="BudgetTransfers" asp-action="Index">🔄 Budget Transfers</a></li>
            <li class="mb-1"><a class="d-block py-1 px-2" asp-controller="Reports" asp-action="Index">📈 Reports</a></li>
            <li class="mb-1"><a class="d-block py-1 px-2" asp-controller="Audit" asp-action="Index">🔍 Audit Log</a></li>
        </ul>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="border-top pt-3 mt-3">
                <small class="text-muted d-block mb-1">@User.Identity.Name</small>
                <small class="text-muted d-block mb-2">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</small>
                <a asp-controller="Account" asp-action="Logout" class="btn btn-sm btn-outline-light w-100">Logout</a>
            </div>
        }
    </nav>
    <!-- Main content -->
    <div id="content" class="p-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script>
    $(function () { $('table.datatable').DataTable({ pageLength: 25 }); });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
