@model ITBudgeting.Web.ViewModels.CreateBudgetTransferViewModel
@{ ViewData["Title"] = "New Budget Transfer"; }
<h2 class="mb-4">New Budget Transfer</h2>
<div class="card" style="max-width:580px">
  <div class="card-body">
    <form asp-action="Create" method="post">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="All" class="text-danger small mb-2"></div>
      <div class="mb-3">
        <label asp-for="VersionId" class="form-label">Budget Version</label>
        <select asp-for="VersionId" asp-items="Model.Versions" class="form-select"><option value="">-- Select --</option></select>
      </div>
      <div class="row">
        <div class="col mb-3">
          <label asp-for="FromProjectId" class="form-label">From Project</label>
          <select asp-for="FromProjectId" asp-items="Model.Projects" class="form-select"><option value="">-- Select --</option></select>
        </div>
        <div class="col mb-3">
          <label asp-for="ToProjectId" class="form-label">To Project</label>
          <select asp-for="ToProjectId" asp-items="Model.Projects" class="form-select"><option value="">-- Select --</option></select>
        </div>
      </div>
      <div class="row">
        <div class="col mb-3">
          <label asp-for="Amount" class="form-label"></label>
          <input asp-for="Amount" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col mb-3">
          <label asp-for="Category" class="form-label"></label>
          <select asp-for="Category" asp-items="Html.GetEnumSelectList<ITBudgeting.Domain.Enums.BudgetCategory>()" class="form-select"></select>
        </div>
      </div>
      <div class="mb-3">
        <label asp-for="Period" class="form-label">Period (YYYY-MM)</label>
        <input asp-for="Period" class="form-control" placeholder="2026-06" />
      </div>
      <div class="mb-3">
        <label asp-for="Reason" class="form-label"></label>
        <textarea asp-for="Reason" class="form-control" rows="2"></textarea>
      </div>
      <div class="mb-3">
        <label asp-for="ApprovedBy" class="form-label"></label>
        <input asp-for="ApprovedBy" class="form-control" />
      </div>
      <button type="submit" class="btn btn-primary">Transfer</button>
      <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
  </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
