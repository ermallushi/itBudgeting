@model IEnumerable<ITBudgeting.Application.DTOs.BudgetTransferDto>
@{ ViewData["Title"] = "Budget Transfers"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🔄 Budget Transfers</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Transfer</a>
</div>
<table class="table table-striped datatable">
    <thead class="table-dark">
        <tr><th>From Project</th><th>To Project</th><th class="text-end">Amount</th><th>Category</th><th>Period</th><th>Reason</th><th>Approved By</th><th>Date</th></tr>
    </thead>
    <tbody>
    @foreach (var t in Model)
    {
        <tr>
            <td><small>@t.FromProjectId.ToString()[..8]…</small></td>
            <td><small>@t.ToProjectId.ToString()[..8]…</small></td>
            <td class="text-end">@t.Amount.ToString("C")</td>
            <td><span class="badge text-bg-@(t.Category.ToString() == "CapEx" ? "info" : "secondary")">@t.Category</span></td>
            <td>@t.Period</td>
            <td>@t.Reason</td>
            <td>@t.ApprovedBy</td>
            <td>@t.CreatedAt.ToString("yyyy-MM-dd")</td>
        </tr>
    }
    </tbody>
</table>
