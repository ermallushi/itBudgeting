@model ITBudgeting.Web.ViewModels.CreatePurchaseOrderViewModel
@{ ViewData["Title"] = "New Purchase Order"; }
<h2 class="mb-4">New Purchase Order</h2>
<div class="card" style="max-width:500px">
  <div class="card-body">
    <form asp-action="Create" method="post">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="All" class="text-danger small mb-2"></div>
      <div class="mb-3">
        <label asp-for="PurchaseRequestId" class="form-label">Purchase Request</label>
        <select asp-for="PurchaseRequestId" asp-items="Model.PurchaseRequests" class="form-select"><option value="">-- Select --</option></select>
      </div>
      <div class="mb-3">
        <label asp-for="AmountApproved" class="form-label"></label>
        <input asp-for="AmountApproved" class="form-control" type="number" step="0.01" />
      </div>
      <button type="submit" class="btn btn-primary">Create</button>
      <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
  </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
