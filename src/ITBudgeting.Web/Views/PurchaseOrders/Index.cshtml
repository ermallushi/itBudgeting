@using ITBudgeting.Domain.Enums
@model IEnumerable<ITBudgeting.Application.DTOs.PurchaseOrderDto>
@{ ViewData["Title"] = "Purchase Orders"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📦 Purchase Orders</h2>
    <a asp-action="Create" class="btn btn-primary">+ New PO</a>
</div>
<table class="table table-striped datatable">
    <thead class="table-dark"><tr><th>ID</th><th class="text-end">Approved</th><th class="text-end">Used</th><th class="text-end">Remaining</th><th>Status</th><th>Created At</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var po in Model)
    {
        var pct = po.AmountApproved > 0 ? po.AmountUsed / po.AmountApproved : 0m;
        var rowClass = pct > 0.9m ? "table-warning" : "";
        var badge = po.Status switch {
            PurchaseOrderStatus.Open           => "primary",
            PurchaseOrderStatus.PartiallyUsed  => "warning",
            PurchaseOrderStatus.Closed         => "secondary",
            _ => "secondary"
        };
        <tr class="@rowClass">
            <td><small class="text-muted">@po.Id.ToString()[..8]…</small></td>
            <td class="text-end">@po.AmountApproved.ToString("C")</td>
            <td class="text-end">@po.AmountUsed.ToString("C")</td>
            <td class="text-end @(po.RemainingAmount < 0 ? "text-danger" : "")">@po.RemainingAmount.ToString("C")</td>
            <td><span class="badge text-bg-@badge">@po.Status</span></td>
            <td>@po.CreatedAt.ToString("yyyy-MM-dd")</td>
            <td>
                <a asp-action="RecordUsage" asp-route-id="@po.Id" class="btn btn-sm btn-outline-info">Record Usage</a>
            </td>
        </tr>
    }
    </tbody>
</table>
